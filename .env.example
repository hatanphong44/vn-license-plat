# LPR Runtime Environment Variables
# Copy this to .env and configure

# Model paths
YOLO_MODEL_PATH=/models/plate_detector/Plate.pt
YOLO_DEVICE=0
PADDLE_DEVICE=gpu:0

# Model parameters
YOLO_CONF=0.25
YOLO_IOU=0.45
OCR_UPSCALE=4
TEXT_PADDING=10
REC_MIN_SCORE=0.0

# Camera settings
CAMERA_SOURCE=rtsp://192.168.1.100:554/stream
INFERENCE_FPS=5.0
CAMERA_RECONNECT_DELAY=3
CAMERA_CONNECT_TIMEOUT=10
CAMERA_BUFFER_SIZE=1

# Runtime settings
PLATE_COOLDOWN_SECONDS=30.0
MAX_CAPTURE_FRAMES=20
MAX_CAPTURE_WAIT_SECONDS=10.0

# Event publisher
CALLBACK_URL=http://your-server.com/api/plates
CALLBACK_TIMEOUT=5.0
CALLBACK_RETRY_COUNT=3
CALLBACK_RETRY_DELAY=1.0

# Visualization
VISUALIZE=false
DISPLAY_FPS=true
SHOW_BOX=true
SHOW_TEXT=true

# Logging
LOG_LEVEL=INFO
DEBUG=false
